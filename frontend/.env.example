# CoinRadar Frontend

# Backend API base URL (include /api path)
# Leave blank for local dev (Vite proxy handles it)
# Example for Railway: https://your-backend.up.railway.app/api
VITE_API_URL=

# Backend WebSocket URL (wss:// for production)
# Leave blank for local dev (uses same origin)
# Example for Railway: wss://your-backend.up.railway.app
VITE_WS_URL=
